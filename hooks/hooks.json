{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/binary/langsmith-tracing.cmd\" before-submit-prompt",
        "failClosed": true,
        "timeout": 15
      }
    ],
    "afterAgentResponse": [
      { "command": "\"${CURSOR_PLUGIN_ROOT}/binary/langsmith-tracing.cmd\" after-agent-response" }
    ],
    "postToolUse": [
      { "command": "\"${CURSOR_PLUGIN_ROOT}/binary/langsmith-tracing.cmd\" post-tool-use" }
    ],
    "postToolUseFailure": [
      { "command": "\"${CURSOR_PLUGIN_ROOT}/binary/langsmith-tracing.cmd\" post-tool-use-failure" }
    ],
    "subagentStart": [
      { "command": "\"${CURSOR_PLUGIN_ROOT}/binary/langsmith-tracing.cmd\" subagent-start" }
    ],
    "subagentStop": [
      { "command": "\"${CURSOR_PLUGIN_ROOT}/binary/langsmith-tracing.cmd\" subagent-stop" }
    ],
    "stop": [{ "command": "\"${CURSOR_PLUGIN_ROOT}/binary/langsmith-tracing.cmd\" stop" }],
    "sessionStart": [
      { "command": "\"${CURSOR_PLUGIN_ROOT}/binary/langsmith-tracing.cmd\" session-start" }
    ]
  }
}
