#!/bin/sh
set -eu

here=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)
arm64_build="$here/langsmith-cursor-tracing-darwin-arm64"
x64_build="$here/langsmith-cursor-tracing-darwin-x64"

if [ "$(uname -s)" = "Darwin" ]; then
  if [ "$(uname -m)" = "arm64" ]; then
    if [ -x "$arm64_build" ]; then
      exec "$arm64_build" "$@"
    fi
    if [ -x "$x64_build" ]; then
      exec "$x64_build" "$@"
    fi
  elif [ -x "$x64_build" ]; then
    exec "$x64_build" "$@"
  fi
fi

exec node "$here/../bundle/guard.js" "$@"
